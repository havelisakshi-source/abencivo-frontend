# Only needed if the backend is on a different domain than this frontend
# (which it will be, since they're deployed separately). Set this to your
# backend's live URL + /api, then run `npm run build`.
#
# Example: VITE_API_BASE=https://abencivo-api.onrender.com/api
#
# If left unset: falls back to http://localhost:4000/api in dev, or a
# same-origin relative /api path in a production build (only correct if
# this frontend happens to be served from the same domain as the backend).
VITE_API_BASE=https://abencivo-bio.onrender.com
